---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import MainContent from "../../../components/MainContent.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import ServiceSidebar from "../../../components/ServiceSidebar.astro";

export function getStaticPaths() {
  return [
    { params: { service: 'contracting' }},
    { params: { service: 'property-management' }},
  ];
}

const { service } = Astro.params;
const servicesData = await getCollection(service as 'contracting' | 'property-management', entry => entry.id.startsWith('services/'));
const sortedServices = servicesData.sort((a, b) => a.data.order - b.data.order);
const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: `${service === 'contracting' ? 'Contracting' : 'Property Management'} Services` },
];

const pageTitle = `${service === 'contracting' ? 'Contracting' : 'Property Management'} Services`;
---
<Layout title={pageTitle}>
  <MainContent class="max-w-screen-xl mx-auto px-4 py-8">
    <Breadcrumb items={breadcrumbItems} />
    
    <div class="flex gap-8">
      <ServiceSidebar 
        activeItem={pageTitle}
        parent={service}
      />
      
      <div class="flex-1">
        <h1 class="text-4xl font-bold text-primary-dark mb-12">
          {pageTitle}
        </h1>
        
        <div class="grid grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedServices.map((service) => (
            <a 
              href={`/${Astro.params.service}/services/${service.id.replace('services/', '')}`}
              class="bg-gray-200 hover:bg-gray-300 transition-all duration-300 p-8S text-center group col-span-1 shadow-md hover:shadow-xl overflow-hidden"
            >
              <div 
                class="w-full h-64 object-cover relative "
                style={{
                  backgroundImage: `url(${service.data.images[0].src})`,
                  backgroundSize: 'cover'
                }}
              >
                <div class="absolute inset-0 bg-gray-800/30 group-hover:bg-gray-800/60 transition-colors"></div>
                <h2 class="text-2xl font-semibold text-white relative z-10 p-4 group-hover:scale-105 origin-center transition-all">
                  {service.data.title}
                </h2>
              </div>
              {/* <img 
                  src={service.data.images[0].src} 
                  alt={service.data.images[0].alt}
                  class="w-full h-64 object-cover"
                /> */}
            </a>
          ))}
        </div>
      </div>
    </div>
    
  </MainContent>
</Layout> 