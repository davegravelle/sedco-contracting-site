---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import MainContent from "../../../components/MainContent.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import ServiceSidebar from "../../../components/ServiceSidebar.astro";
import CustomAstroImage from "../../../components/CustomAstroImage.astro";

export async function getStaticPaths() {
  const services = [
    { type: 'contracting', collection: await getCollection('contracting', entry => entry.id.startsWith('services/')) },
    { type: 'property-management', collection: await getCollection('property-management', entry => entry.id.startsWith('services/')) }
  ];

  return services.flatMap(({ type, collection }) => 
    collection.map(entry => ({
      params: { 
        service: type,
        slug: entry.id.replace('services/', '')
      },
      props: { entry }
    }))
  );
}

const { service } = Astro.params;
const { entry } = Astro.props;

const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: `${service} Services`, href: `/${service}/services` },
  { label: entry.data.title },
];
---
<Layout title={entry.data.title}>
  <MainContent class="max-w-screen-xl mx-auto px-4 py-8">
    <Breadcrumb items={breadcrumbItems} />
    
    <div class="flex gap-8">
      <ServiceSidebar 
        activeItem={entry.data.title}
        parent={service}
      />
      
      <div class="flex-1">
        <h1 class="text-4xl font-bold text-primary-dark mb-8">
          {entry.data.title}
        </h1>
        
        <p class="text-lg text-gray-700 mb-8">
          {entry.data.description}
        </p>
        
        {entry.data.images && entry.data.images.length > 0 && (
          <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6 mt-8">
            {entry.data.images.map((image) => (
              <CustomAstroImage
                className="relative m-auto max-w-[360px] max-h-[360px] w-full object-cover"
                imagePath={image.src}
                alt={image.alt}
              />
            ))}
          </div>
        )}
      </div>
    </div>
  </MainContent>
</Layout> 