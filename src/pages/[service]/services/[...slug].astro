---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import MainContent from "../../../components/MainContent.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import ServiceSidebar from "../../../components/ServiceSidebar.astro";

export async function getStaticPaths() {
  const services = [
    { type: 'contracting', collection: await getCollection('contracting', entry => entry.id.startsWith('services/')) },
    { type: 'property-management', collection: await getCollection('property-management', entry => entry.id.startsWith('services/')) }
  ];

  return services.flatMap(({ type, collection }) => 
    collection.map(entry => ({
      params: { 
        service: type,
        slug: entry.id.replace('services/', '')
      },
      props: { entry }
    }))
  );
}

const { service, slug } = Astro.params;
const { entry } = Astro.props;

const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: `${service === 'contracting' ? 'Contracting' : 'Property Management'} Services`, href: `/${service}/services` },
  { label: entry.data.title },
];
---
<Layout title={entry.data.title}>
  <MainContent class="max-w-screen-xl mx-auto px-4 py-8">
    <Breadcrumb items={breadcrumbItems} />
    
    <div class="flex gap-8">
      <ServiceSidebar 
        activeItem={entry.data.title}
        parent={service}
      />
      
      <div class="flex-1">
        <h1 class="text-4xl font-bold text-primary-dark mb-8">
          {entry.data.title}
        </h1>
        
        <p class="text-lg text-gray-700 mb-8">
          {entry.data.description}
        </p>
        
        {entry.data.images && entry.data.images.length > 0 && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
            {entry.data.images.map((image) => (
              <figure class="relative">
                <img 
                  src={image.src} 
                  alt={image.alt}
                  class="w-full h-64 object-cover rounded-lg"
                />
                {image.caption && (
                  <figcaption class="mt-2 text-sm text-gray-600 italic">
                    {image.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        )}
      </div>
    </div>
  </MainContent>
</Layout> 