---
// @ts-nocheck
import { contentfulClient } from "../../lib/contentful";
import Layout from "../../layouts/Layout.astro";
import MainContent from "../../components/MainContent.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";

  const entries = await contentfulClient.getEntries({
    content_type: "productGroup",
  });

 const products = entries.items.map((item) => {
    const { title, products } = item.fields;
    return {
        title,
        products,
    };
  });

// const { serviceType } = Astro.params;
const {
  title = "Products",
} = Astro.props;


const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: title as string, href: "" },
];

---
<Layout title={title as string}>
  <MainContent class="max-w-screen-xl mx-auto px-4 py-8">
    <Breadcrumb items={breadcrumbItems} />
    
    <div class="flex gap-8">
      <div class="flex-1">
        <h1 class="text-3xl text-primary-dark font-bold mb-6">Products We Use and Recommend</h1>
        {products.map((category) => (
          <div class="mb-12">
            <h2 class="text-2xl text-primary-dark font-bold mb-4">{category.title}</h2> 
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {category?.products?.map((item) => (
                // Product Card
                <div class="border border-gray-200 rounded-lg p-6 bg-white h-64 max-w-xs flex flex-col">
                  <div class="h-16 flex items-center">
                    <img src={item.fields?.image?.fields?.file?.url} alt={""} class="max-h-full" />
                  </div>
                  <div class="mt-4 flex-grow flex flex-col">
                    {item?.fields?.description && <p class="flex-grow">{item.fields.description}</p>}
                    {item?.fields?.cost && (
                      <div class="mt-2">
                        {Array.from({ length: 3 }).map((_, i) => (
                          <span class={`text-2xl tracking-widest font-bold spacing- ${(i + 1) <= item.fields.cost ? 'text-primary-dark' : 'text-gray-400'}`}>$</span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
        
      </div>
    </div>
    
  </MainContent>
</Layout> 