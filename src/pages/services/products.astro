---
import { contentfulClient } from "../../lib/contentful";
import Layout from "../../layouts/Layout.astro";
import MainContent from "../../components/MainContent.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";

  const entries = await contentfulClient.getEntries({
    content_type: "productGroup",
  });

 const products = entries.items.map((item) => {
    console.log(item)
    const { title, products, slug } = item.fields;
    return {
        title,
        slug,
        products,
    };
  });

// const { serviceType } = Astro.params;
const {
  title = "Products",
  slug,
} = Astro.props;


const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: title as string, href: "" },
];

---
<Layout title={title as string}>
  <MainContent class="max-w-screen-xl mx-auto px-4 py-8">
    <Breadcrumb items={breadcrumbItems} />
    
    <div class="flex gap-8">
      <div class="flex-1">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {products && products?.map((product) => (
            <div
              class="group transition-all duration-300 p-8S text-center col-span-1 overflow-hidden flex justify-center"
            >
              <div 
                class="w-full h-64 max-w-[360px] max-h-[360px] object-cover shadow-md hover:shadow-xl relative"
              >
                <div class="absolute inset-0 w-full h-full bg-gray-800/20 group-hover:bg-gray-800/30 transition-colors z-10"></div>
                <h2 class="text-2xl font-semibold text-white relative z-20 p-4 group-hover:scale-105 origin-center transition-all">
                  {product.title}
                </h2>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    
  </MainContent>
</Layout> 