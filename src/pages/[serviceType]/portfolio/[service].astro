---
// @ts-nocheck
import { contentfulClient } from "../../../lib/contentful";
import Layout from "../../../layouts/Layout.astro";
import AnimatedWrapper from "../../../components/AnimatedWrapper.astro";
import Banner from "../../../components/ui/Banner.astro";
import Title from "../../../components/ui/Title.astro";

import MainContent from "../../../components/MainContent.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import VerticalNav from "../../../components/ui/VerticalNav/VerticalNav.astro";

// images
import kitchen from "../../../assets/kitchen-640.jpeg";
import lawn from "../../../assets/park-plus-resized.png";

// types
import type { NavItem } from "../../../components/VerticalNav.astro";
import { buildVertNav } from "../../../components/ui/VerticalNav/verticalNav.helpers";

// TODO: consolidate this logic in lib/contentful
export async function getStaticPaths() {
  const entries = await contentfulClient.getEntries({
    content_type: "services",
  });

  const paths = [];
  const navItems: NavItem[] = buildVertNav(entries.items);

  entries.items.forEach((servicesItem) => {
    servicesItem?.fields?.servicesOffered?.forEach((item) => {
      const { name, description, images, slug } = item.fields;

      paths.push({
        params: {
          serviceType: servicesItem.fields.slug,
          service: slug,
        },
        props: {
          name,
          description,
          images,
          navItems,
          slug,
        },
      });
    });
  });

  return paths;
}

const { service, serviceType } = Astro.params;
const { description, images, name, navItems, slug } = Astro.props;

const breadcrumbItems = [
  { label: `${serviceType}`, href: `/${serviceType}` },
  { label: name },
];
---

<Layout title={name}>
  {
    serviceType === "construction" ? (
      <Banner imgSrc={kitchen}>
        {/* <AnimatedWrapper> */}
        <Title
          mobileSize="5xl"
          desktopSize="7xl"
          color="text-white"
          fontWeight="bold"
          class="relative z-10"
        >
          Construction & Remodeling
        </Title>
        <Title
          element="h2"
          mobileSize="3xl"
          desktopSize="3xl"
          fontWeight="thin"
          color="text-white"
          class="relative z-10 mt-2 md:mt-4 lg:mt-6"
        >
          Commercial & Residential
        </Title>
        {/* </AnimatedWrapper> */}
      </Banner>
    ) : (
      <Banner imgSrc={lawn}>
        {/* <AnimatedWrapper> */}
        <Title
          mobileSize="5xl"
          desktopSize="7xl"
          color="text-white"
          fontWeight="bold"
          class="relative z-10"
        >
          Property Maintenance
        </Title>
        <Title
          element="h2"
          mobileSize="3xl"
          desktopSize="3xl"
          fontWeight="thin"
          color="text-white"
          class="relative z-10 mt-2 md:mt-4 lg:mt-6"
        >
          Commercial & Select Residential
        </Title>
        {/* </AnimatedWrapper> */}
      </Banner>
    )
  }
  <MainContent class="max-w-screen-xl mx-auto px-4 py-8">
    <Breadcrumb items={breadcrumbItems} />

    <div class="flex gap-8">
      <VerticalNav
        items={navItems}
        activePath={slug as string}
        expandible={false}
      />

      <div class="flex-1">
        <h2 class="text-4xl font-title font-bold text-primary-dark mb-8">
          {name}
        </h2>

        <p class="text-lg text-gray-700 mb-8">
          {description}
        </p>

        {
          images?.length > 0 && (
            <div class="grid sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
              {images.map((image) => (
                <img
                  class="relative m-auto max-w-[360px] max-h-[360px] w-full object-cover"
                  src={image.fields.file.url}
                  alt={""}
                />
              ))}
            </div>
          )
        }
      </div>
    </div>
  </MainContent>
</Layout>
