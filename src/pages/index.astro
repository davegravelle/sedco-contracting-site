---
import Layout from "../layouts/Layout.astro";
// custom
// import Images from "../components/Images.astro";
// import Hero from "../components/Hero.astro";
import MainContent from "../components/MainContent.astro";
// import Review from "../components/Review.astro";
// import AnimatedWrapper from "../components/AnimatedWrapper.astro";
import ContactForm from "../components/ContactForm.astro";
import Card from "../components/Card.astro";


// Import images directly
import image1 from "../assets/kitchen-640.jpeg";
import image2 from "../assets/landscaping1-640.jpg";

const cards = [
  {
    subtitle: "Commercial and residential remodeling",
    title: "Sedco Contracting LLC",
    list: [
      "Kitchens",
      "Bathrooms",
      "Fireplaces",
      "Decks & Porches",
      "Garages",
    ],
    href: "/contracting/services",
    imgSrc: image1,
  },
  {
    title: "Sedco Property Maintenance LLC",
    subtitle: "Commercial landscaping and snow removal ",
    list: [
      "Lawn maintenance",
      "Landscaping",
      "Hardscaping",
      "Snow plowing & removal",
      "Ice management",
    ],
    href: "/property-management/services",
    imgSrc: image2,
  },
];
---

<Layout title="Home">
  <MainContent class="pt-0 pb-0 mb-12 max-w-screen-xl mx-auto bg-white">
    <section class="px-4 py-8 sm:p-8 bg-white">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-4">
        {
          cards.map((card) => (
            <div class="flex justify-center">
              <Card {...card} />
            </div>
          ))
        }
      </div>
    </section>

    <section class="px-4 py-8 sm:p-8 bg-white">
      <h1 class="text-3xl text-center font-bold text-primary-dark mb-8">
        Get In Touch!
      </h1>
      <p class="max-w-md mx-auto text-primary-dark text-center mb-8">
        We're still working on the rest of our site but in the meantime we're
        happy to answer any questions you have about our services. Fill out the
        form below and we'll get back to you as soon as possible!
      </p>
      <ContactForm />
    </section>
  </MainContent>
</Layout>
