---
import Layout from "../layouts/Layout.astro";
// custom
// import Images from "../components/Images.astro";
// import Hero from "../components/Hero.astro";
import MainContent from "../components/MainContent.astro";
// import Review from "../components/Review.astro";
// import AnimatedWrapper from "../components/AnimatedWrapper.astro";
import ContactForm from "../components/ContactForm.astro";
import Card from "../components/Card.astro";
import ContentBlock from "../components/ui/ContentBlock.astro";
import Title from "../components/ui/Title.astro";
import Banner from "../components/ui/Banner.astro";

// Import images directly
import image1 from "../assets/kitchen-640.jpeg";
import image2 from "../assets/landscaping1-640.jpg";
import bannerImage from "../assets/framing-background.png";

import { getServicesMainImages } from "../lib/contentful";
import Overlay from "../components/ui/Overlay.astro";

const serviceData = await getServicesMainImages();

// const cards = [
//   {
//     subtitle: "Commercial and residential remodeling",
//     title: "Sedco Contracting LLC",
//     list: ["Kitchens", "Bathrooms", "Fireplaces", "Decks & Porches", "Garages"],
//     href: "/services#remodeling",
//     imgSrc: image1,
//   },
//   {
//     title: "Sedco Property Maintenance LLC",
//     subtitle: "Commercial landscaping and snow removal ",
//     list: [
//       "Lawn maintenance",
//       "Landscaping",
//       "Hardscaping",
//       "Snow plowing & removal",
//       "Ice management",
//     ],
//     href: "/services#snowRemoval",
//     imgSrc: image2,
//   },
// ];
---

<Layout title="Home">
  <MainContent class="pt-0 pb-0 mb-12 max-w-screen-xl mx-auto bg-white">
    <Banner imgSrc={bannerImage}>
      <Title
        mobileSize="3xl"
        desktopSize="5xl"
        color="text-white"
        fontWeight="medium"
        class="relative z-10 leading-[1.3]"
      >
        Serving the Northern
        <br />
        & Central New Jersey Area
      </Title>
      <Title
        element="h2"
        mobileSize="2xl"
        desktopSize="2xl"
        fontWeight="thin"
        color="text-white"
        class="relative z-10"
      >
        since 2003
      </Title>
    </Banner>
    <!-- <section class="px-4 py-8 sm:p-8 bg-white">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-4">
        {
          cards.map((card) => (
            <div class="flex justify-center">
              <Card {...card} />
            </div>
          ))
        }
      </div>
    </section> -->

    <ContentBlock
      title="Construction & Remodeling"
      contentPlacement="left"
      class="bg-primary-dark text-primary"
      content={`
        <ul>
          <li>Commercial & Residential</li>
          <li>Kitchens & Baths</li>
          <li>Fireplaces</li>
          <li>Decks & Porches</li>
          <li>Additions</li>
        </ul>
      `}
      imgSrc="src/assets/kitchen-640.jpeg"
      imgAlt=""
    />
    <ContentBlock
      class="bg-accent-slate text-white"
      title="Construction & Remodeling"
      contentPlacement="right"
      content={`
        <ul>
          <li>Commercial & Residential</li>
          <li>Kitchens & Baths</li>
          <li>Fireplaces</li>
          <li>Decks & Porches</li>
          <li>Additions</li>
        </ul>
      `}
      imgSrc="src/assets/kitchen-640.jpeg"
      imgAlt=""
    />
    <ContentBlock
      class="bg-accent-beige"
      title="Construction & Remodeling"
      contentPlacement="center"
      content={`
        <ul>
          <li>Commercial & Residential</li>
          <li>Kitchens & Baths</li>
          <li>Fireplaces</li>
          <li>Decks & Porches</li>
          <li>Additions</li>
        </ul>
      `}
      imgSrc="src/assets/kitchen-640.jpeg"
      imgAlt=""
    />

    <section class="my-16 px-4 lg:px-0">
      <Title
        element="h2"
        desktopSize="4xl"
        mobileSize="3xl"
        class="text-center mb-8"
      >
        Our Portfolio
      </Title>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4 lg:gap-8">
        {
          serviceData.map(
            (service: any) =>
              service?.mainImage?.url && (
                <a
                  href={`/portfolio/${service.name.toLowerCase()}`}
                  class="group"
                >
                  <div class="flex justify-center relative ">
                    <Overlay class="z-10" />
                    <Title
                      element="h3"
                      mobileSize="2xl"
                      desktopSize="3xl"
                      class="absolute z-20 self-center transition-all duration-400 ease-in-out group-hover:scale-110 text-center"
                      color="text-white"
                    >
                      {service?.name?.includes("&") ? (
                        <div>
                          {service.name.split("&")[0]}
                          <div>&</div>
                          {service.name.split("&")[1]}
                        </div>
                      ) : (
                        service.name
                      )}
                    </Title>
                    {service?.mainImage?.url && (
                      <img
                        src={`${service?.mainImage?.url}?w=420&h=420&fit=scale&f=center`}
                        alt=""
                        class="relative top-0 left-0 w-full h-full object-cover"
                      />
                    )}
                  </div>
                </a>
              ),
          )
        }
      </div>
    </section>

    <section class="px-4 py-8 sm:p-8 bg-white">
      <Title
        element="h2"
        class="text-center mb-8"
        desktopSize="3xl"
        mobileSize="3xl"
      >
        Get In Touch!
      </Title>
      <p class="max-w-md mx-auto text-primary-dark text-center mb-8">
        We're still working on the rest of our site but in the meantime we're
        happy to answer any questions you have about our services. Fill out the
        form below and we'll get back to you as soon as possible!
      </p>
      <ContactForm />
    </section>
  </MainContent>
</Layout>
