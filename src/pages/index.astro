    <section class="px-4 py-8 sm:p-8 bg-white">
      <AnimatedWrapper>
        <Title
          element="h2"
          class="text-center mb-8"
          desktopSize="4xl"
          mobileSize="3xl"
          fontWeight="bold"
        >
          Get In Touch!
        </Title>
        <p class="max-w-md mx-auto text-primary-dark text-xl text-center mb-8">
          We're still working on the rest of our site but in the meantime we're
          happy to answer any questions you have about our services. Fill out
          the form below and we'll get back to you as soon as possible!
