---
import Layout from "../layouts/Layout.astro";
// custom components
import AnimatedWrapper from "../components/AnimatedWrapper.astro";
import MainContent from "../components/MainContent.astro";
import ContactForm from "../components/ContactForm.astro";
import Title from "../components/ui/Title.astro";
import Banner from "../components/ui/Banner.astro";

// Import images directly
import kitchen from "../assets/kitchen-640.jpeg";
import lawn from "../assets/park-plus-resized.png";
---

<Layout title="Home">
  <MainContent class="pt-0 pb-0 mx-auto bg-white">
    <Banner imgSrc={kitchen}>
      <AnimatedWrapper>
        <Title
          mobileSize="5xl"
          desktopSize="7xl"
          color="text-white"
          fontWeight="bold"
          class="relative z-10"
        >
          Construction & Remodeling
        </Title>
        <Title
          element="h2"
          mobileSize="3xl"
          desktopSize="3xl"
          fontWeight="thin"
          color="text-white"
          class="relative z-10 mt-2 md:mt-4 lg:mt-6"
        >
          Commercial & Residential
        </Title>
      </AnimatedWrapper>
    </Banner>
    <Banner imgSrc={lawn}>
      <AnimatedWrapper delay="0.25">
        <Title
          mobileSize="5xl"
          desktopSize="7xl"
          color="text-white"
          fontWeight="bold"
          class="relative z-10"
        >
          Property Maintenance
        </Title>
        <Title
          element="h2"
          mobileSize="3xl"
          desktopSize="3xl"
          fontWeight="thin"
          color="text-white"
          class="relative z-10 mt-2 md:mt-4 lg:mt-6"
        >
          Commercial & Select Residential
        </Title>
      </AnimatedWrapper>
    </Banner>
