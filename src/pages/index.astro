---
import Layout from "../layouts/Layout.astro";
// custom components
import MainContent from "../components/MainContent.astro";
import ContactForm from "../components/ContactForm.astro";
import ContentBlock from "../components/ui/ContentBlock.astro";
import Title from "../components/ui/Title.astro";
import Banner from "../components/ui/Banner.astro";
import Overlay from "../components/ui/Overlay.astro";

// Import images directly
import bannerImage from "../assets/framing-background.png";

// data
import servicesJSON from "../data/services.json";
import { getServicesMainImages } from "../lib/contentful";

const serviceData = await getServicesMainImages();
---

<Layout title="Home">
  <MainContent class="pt-0 pb-0 max-w-screen-xl mx-auto bg-white">
    <Banner imgSrc={bannerImage}>
      <Title
        mobileSize="3xl"
        desktopSize="5xl"
        color="text-white"
        fontWeight="bold"
        class="relative z-10 leading-[1.3]"
      >
        Serving the Northern
        <br />
        & Central New Jersey Area
      </Title>
      <Title
        element="h2"
        mobileSize="2xl"
        desktopSize="2xl"
        fontWeight="thin"
        color="text-white"
        class="relative z-10 mt-2 md:mt-4 lg:mt-6"
      >
        Since 2003
      </Title>
    </Banner>
    <!-- <section class="px-4 py-8 sm:p-8 bg-white">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-4">
        {
          cards.map((card) => (
            <div class="flex justify-center">
              <Card {...card} />
            </div>
          ))
        }
      </div>
    </section> -->
    {
      servicesJSON.services.map((service, i) => (
        <ContentBlock
          contentPlacement={i % 2 === 0 ? "left" : "right"}
          class={`${service.bgColor} ${service.bgColor.includes("light") ? "text-primary-dark" : "text-primary"}`}
          imgSrc={service.imagePath}
          imgAlt=""
        >
          <Title element="h2" desktopSize="4xl" mobileSize="3xl" class="mb-4">
            {service.name}
          </Title>
          <ul class="text-xl space-y-2">
            {service.subcategories.map((subCat) => (
              <li>{subCat}</li>
            ))}
          </ul>
        </ContentBlock>
      ))
    }

    <section class="my-16 px-4 lg:px-8">
      <Title
        element="h2"
        desktopSize="4xl"
        mobileSize="3xl"
        class="text-center mb-16"
      >
        Our Portfolio
      </Title>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4 lg:gap-8">
        {
          serviceData.map(
            (service: any) =>
              service?.mainImage?.url && (
                <a
                  href={`/portfolio/${service.name.toLowerCase()}`}
                  class="group"
                >
                  <div class="flex justify-center relative ">
                    <Overlay class="z-10" />
                    <Title
                      element="h3"
                      mobileSize="2xl"
                      desktopSize="3xl"
                      class="absolute z-20 self-center transition-all duration-400 ease-in-out group-hover:scale-110 text-center"
                      color="text-white"
                    >
                      {service?.name?.includes("&") ? (
                        <div>
                          {service.name.split("&")[0]}
                          <div>&</div>
                          {service.name.split("&")[1]}
                        </div>
                      ) : (
                        service.name
                      )}
                    </Title>
                    {service?.mainImage?.url && (
                      <img
                        src={`${service?.mainImage?.url}?w=420&h=420&fit=scale&f=center`}
                        alt=""
                        class="relative top-0 left-0 w-full h-full object-cover"
                      />
                    )}
                  </div>
                </a>
              ),
          )
        }
      </div>
    </section>

    <section class="px-4 py-8 sm:p-8 bg-white">
      <Title
        element="h2"
        class="text-center mb-8"
        desktopSize="4xl"
        mobileSize="3xl"
        fontWeight="bold"
      >
        Get In Touch!
      </Title>
      <p class="max-w-md mx-auto text-primary-dark text-xl text-center mb-8">
        We're still working on the rest of our site but in the meantime we're
        happy to answer any questions you have about our services. Fill out the
        form below and we'll get back to you as soon as possible!
      </p>
      <ContactForm />
    </section>
  </MainContent>
</Layout>
