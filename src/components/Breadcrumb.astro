---
interface Props {
  items: {
    label: string;
    href?: string;
  }[];
}

const { items } = Astro.props;
---

<nav class="flex gap-2 items-center text-gray-600 mb-8">
  {items.map((item, index) => (
    <>
      {item.href ? (
        <a href={item.href} class="hover:text-primary-dark transition-colors">
          {item.label}
        </a>
      ) : (
        <span class="text-primary-dark">{item.label}</span>
      )}
      {index < items.length - 1 && <span class="text-gray-400">/</span>}
    </>
  ))}
</nav> 