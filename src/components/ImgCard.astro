---
const { action, imgSrc, imgAlt, title, body, href } = Astro.props;
---

<div
  class="relative max-w-xs border border-solid border-gray-200 rounded-2xl transition-all duration-500"
>
  <div class="block overflow-hidden">
    <img src={imgSrc} alt={imgAlt} />
  </div>
  <div class="p-4">
    <h4
      class="text-base font-semibold text-gray-900 mb-2 capitalize transition-all duration-500"
    >
      {title}
    </h4>
    <p
      class="text-sm font-normal text-gray-500 transition-all duration-500 leading-5 mb-5"
    >
      {body}
    </p>
    <a
      href={href}
      class="bg-indigo-600 shadow-sm rounded-full py-2 px-5 text-xs text-white font-semibold"
      >{action}</a
    >
  </div>
</div>
