---
// src/components/VerticalNavigation.astro
// A reusable vertical navigation component with nested categories

export type NavItem = {
  label: string;
  icon?: string;
  href?: string;
  children?: NavItem[];
  isExpanded?: boolean;
}

interface Props {
  items: NavItem[];
  activePath?: string;
  expandible?: boolean; // Controls whether parent items can be expanded/collapsed
}

const { items, activePath = '', expandible = false } = Astro.props;

// Helper function to determine if an item is active
const isActive = (href: string) => {
  if (!href || !activePath) return false;
  return activePath === href || activePath.startsWith(`${href}/`);
};

// Helper function to determine if an item should be expanded
const shouldExpand = (item: NavItem) => {
  // If expandible is false, always show children
  if (!expandible) return true;
  
  // Otherwise follow normal expansion rules
  if (item.isExpanded) return true;
  if (!item.children) return false;
  
  // Auto-expand if a child is active
  return item.children.some(child => 
    child.href && isActive(child.href)
  );
};
---

<nav class="hidden md:block w-64 text-primary-dark min-h-screen">
  <ul class="space-y-1">
    {items.map((item) => {
      const expanded = shouldExpand(item);
      
      return (
        <li>
          {item.children ? (
            <div>
              {expandible ? (
                <button 
                  class={`flex items-center w-full px-4 py-2 text-left hover:bg-slate-200 transition-all duration-200 ${isActive(item.href || '') ? 'bg-gray-800' : ''}`}
                  aria-expanded={expanded}
                  data-expandible
                >
                  {item.icon && (
                    <span class="mr-3">
                      <i class={item.icon}></i>
                    </span>
                  )}
                  <span class="flex-grow">{item.label}</span>
                  <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    class={`h-4 w-4 transition-transform duration-200 ${expanded ? 'rotate-180' : ''}`} 
                    viewBox="0 0 20 20" 
                    fill="currentColor"
                  >
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </button>
              ) : (
                <div 
                  class={`flex items-center w-full px-2 py-2 hover:bg-slate-200 transition-all duration-200 ${isActive(item.href || '') ? 'bg-gray-800 text-white hover:bg-slate-600' : ''}`}
                >
                  <a href={item.href}>
                    {item.icon && (
                      <span class="mr-3">
                        <i class={item.icon}></i>
                      </span>
                    )}
                    <span class="flex-grow">{item.label}</span>
                  </a>
                </div>
              )}
              
              {/* Nested submenu */}
              <ul class={`ml-2 my-2 space-y-1 border-l-2 border-slate-200 overflow-hidden transition-all duration-200 ${expanded ? 'max-h-96' : 'max-h-0'}`}>
                {item.children.map((child) => (
                  <li>
                    <a 
                      href={child.href} 
                      class={`block pl-2 ml-2 py-2 hover:bg-slate-200 transition-colors duration-200 ${isActive(child.href || '') ? 'text-primary-dark font-bold' : ''}`}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a 
              href={item.href} 
              class={`flex items-center px-4 py-2 hover:bg-slate-200 transition-colors duration-200 ${isActive(item.href || '') ? 'bg-gray-800' : ''}`}
            >
              {item.icon && (
                <span class="mr-3">
                  <i class={item.icon}></i>
                </span>
              )}
              <span>{item.label}</span>
            </a>
          )}
        </li>
      );
    })}
  </ul>
</nav>

<script>
  // Add client-side interactivity for expanding/collapsing menus
  document.addEventListener('DOMContentLoaded', () => {
    // Only target buttons that are marked as expandible
    const buttons = document.querySelectorAll('nav button[data-expandible]');
    
    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
        
        // Toggle the chevron rotation
        const chevron = button.querySelector('svg');
        if (chevron) {
          chevron.classList.toggle('rotate-180');
        }
        
        // Toggle the submenu visibility
        const submenu = button.nextElementSibling;
        if (submenu) {
          submenu.classList.toggle('max-h-0');
          submenu.classList.toggle('max-h-96');
          submenu.classList.toggle('py-1');
        }
      });
    });
  });
</script>