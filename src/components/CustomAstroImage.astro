---
import { Image } from 'astro:assets';

import type { ImageMetadata } from 'astro';

interface Props {
    className?: string;
    imagePath: string;
    alt: string;
}

const { className, imagePath, alt } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif}');
if (!images[imagePath]) console.error(`"${imagePath}" does not exist in glob: "src/assets/**/*.{jpeg,jpg,png,gif}"`);
---
{images[imagePath] ? (
    <Image class={className} src={images[imagePath]() || ''} alt={alt} />
)
: (
    <img class={className} alt={alt} />
)}