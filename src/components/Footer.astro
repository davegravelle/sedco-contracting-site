---
import Facebook from "./icons/Facebook.astro";
import Instagram from "./icons/Instagram.astro";

const currentYear = new Date().getFullYear();
---

<footer class="bg-primary-dark text-accent-light p-8 mt-auto w-full">
  <div class="container max-w-screen-xl mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Column 1: Main Office -->
      <div class="text-center md:text-left">
        <h3 class="font-bold text-xl mb-4">Main Office</h3>
        <address class="not-italic">
          <p class="mb-2">80 Ames Avenue</p>
          <p class="mb-2">Rutherford, NJ 07070</p>
          <p class="mb-2">
            <a href="tel:2014609422" class="hover:text-white transition-colors"
              >(201) 460-9422</a
            >
          </p>
          <!-- <p class="mb-2">
                        <a href="mailto:operations.sedcocontracting@gmail.com" class="hover:text-white transition-colors">
                            operations.sedcocontracting@gmail.com
                        </a>
                    </p> -->
        </address>
      </div>

      <!-- Column 2: Additional Locations -->
      <div class="text-center md:text-left">
        <h3 class="font-bold text-xl mb-4">Locations</h3>
        <div class="mb-4">
          <p class="font-semibold mb-1">Construction Shop</p>
          <address class="not-italic">
            <p>964 Paterson Avenue</p>
            <p>East Rutherford, NJ 07073</p>
          </address>
        </div>
        <div>
          <p class="font-semibold mb-1">Landscape Yard</p>
          <address class="not-italic">
            <p>6 Curie Ave</p>
            <p>Wallington, NJ 07057</p>
          </address>
        </div>
      </div>

      <!-- Column 3: Social & Legal -->
      <div class="text-center md:text-left order-first md:order-last">
        <h3 class="font-bold text-xl mb-4">Connect With Us</h3>
        <div class="flex justify-center md:justify-start gap-4 mb-4">
          <a
            href="https://www.facebook.com/profile.php?id=61576250433363"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-white transition-colors"
          >
            <span class="visually-hidden"> Facebook </span>
            <Facebook height="32" width="32" />
          </a>
          <a
            href="https://www.instagram.com/thesedcocompanies/"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-white transition-colors"
          >
            <span class="visually-hidden"> Instagram </span>
            <Instagram height="32" width="32" />
          </a>
        </div>
      </div>
    </div>
    <div class="mt-8">
      <p class="text-sm">License Number: 13VH00412200</p>
      <p class="text-sm mt-2">
        &copy; {currentYear} Sedco Companies. All rights reserved.
      </p>
    </div>
  </div>
</footer>

