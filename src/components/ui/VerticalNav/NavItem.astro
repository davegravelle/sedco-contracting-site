---
import type { NavItem } from "./VerticalNav.astro";
import { isActive as checkIsActive } from "./verticalNav.helpers";

const { item, activePath, expandible, expanded, depth = 0 } = Astro.props;
---

<li>
  {
    item.children ? (
      <div>
        {expandible ? (
          <button
            class={`flex items-center w-full px-2 mx-2 py-2 text-left hover:bg-slate-200 transition-all duration-200 ${checkIsActive(activePath, item.slug || "") ? "bg-gray-800" : ""}`}
            aria-expanded={expanded}
            data-expandible
          >
            {item.icon && (
              <span class="mr-3">
                <i class={item.icon} />
              </span>
            )}
            <span class="flex-grow">{item.label}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class={`h-4 w-4 transition-transform duration-200 ${expanded ? "rotate-180" : ""}`}
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
        ) : (
          <a href={item.href}>
            <div
              class={`flex items-center w-full px-2 py-2 hover:bg-slate-200 transition-all duration-200 ${checkIsActive(activePath, item.slug || "") ? "bg-gray-800 text-white hover:bg-slate-600" : ""}`}
            >
              {item.icon && (
                <span class="mr-3">
                  <i class={item.icon} />
                </span>
              )}
              <span class="flex-grow">{item.label}</span>
            </div>
          </a>
        )}

        {/* Nested submenu */}
        <ul
          class={`ml-4 my-2 space-y-1 ring-offset-0 ring-transparent overflow-hidden transition-all duration-200 ${expanded ? "max-h-96" : "max-h-0"} ${depth > 0 ? "border-l-2 border-slate-200" : ""}`}
        >
          {item.children.map((child: NavItem) => (
            <Astro.self
              item={child}
              expanded={expanded}
              expandible={expandible}
              activePath={activePath}
              depth={depth + 1}
            />
          ))}
        </ul>
      </div>
    ) : (
      <a
        href={item.href}
        class={`flex items-center px-2 mx-0 py-2 hover:bg-slate-200 transition-colors duration-200 ${checkIsActive(activePath, item.slug || "") ? "bg-gray-800 text-white hover:text-primary-dark px-4" : ""}`}
      >
        {item.icon && (
          <span class="mr-3">
            <i class={item.icon} />
          </span>
        )}
        <span>{item.label}</span>
      </a>
    )
  }
</li>
