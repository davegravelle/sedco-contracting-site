---
interface Props {
  activeItem?: string;
  parent: string;
}

const { activeItem, parent } = Astro.props;

const items = [
  { label: `${parent} Services`, href: `/${parent}/services` },
  { label: "Products", href: `/${parent}/products` },
  { label: "Procedures", href: "/procedures" },
  { label: "Testimonials", href: "/testimonials" },
];
---

<aside class="w-56 hidden lg:flex">
  <nav class="w-full">
    {items.map(item => (
      <a
        href={item.href}
        class={`capitalize block p-4 border-b ${
          activeItem?.toLowerCase() === item.label.toLowerCase()
            ? "bg-primary-dark text-white"
            : "hover:bg-gray-100"
        }`}
      >
        {item.label}
      </a>
    ))}
  </nav>
</aside> 